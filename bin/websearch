#!/usr/bin/env python3
"""
websearch — the fleet's web search, served by local SearXNG.

This is the dependency that did not exist on this machine and that blocked
every research-shaped agent from running locally. It is a plain command, so
agents reach it the same way they reach any other shell tool, and so can you.

  websearch "VARA Dubai rulebook update"
  websearch "stablecoin licensing UAE" --n 10
  websearch "ADGM FSRA consultation" --json

Exits non-zero with a clear message when SearXNG is not up, so an agent fails
loudly instead of quietly returning nothing — which is the failure mode this
whole fleet was rebuilt to avoid.
"""
import json
import sys
import urllib.parse
import urllib.request

ENDPOINT = "http://localhost:8888/search"


def search(query, n=8):
    params = urllib.parse.urlencode({"q": query, "format": "json", "language": "en"})
    req = urllib.request.Request(ENDPOINT + "?" + params,
                                 headers={"User-Agent": "fleet-websearch/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=45) as r:
            data = json.load(r)
    except Exception as e:
        sys.stderr.write(
            "websearch: SearXNG is not answering on localhost:8888 (%s).\n"
            "Start it with:  docker start searxng\n" % type(e).__name__)
        sys.exit(2)
    return data.get("results", [])[:n]


def main():
    args = list(sys.argv[1:])
    if not args:
        sys.stderr.write('usage: websearch "query" [--n 8] [--json]\n')
        sys.exit(1)
    as_json = "--json" in args
    if as_json:
        args.remove("--json")
    n = 8
    if "--n" in args:
        i = args.index("--n")
        n = int(args[i + 1])
        del args[i:i + 2]
    query = " ".join(args)

    results = search(query, n)
    if as_json:
        print(json.dumps(results, indent=2))
        return
    if not results:
        print("no results for %r" % query)
        return
    for i, r in enumerate(results, 1):
        print("%d. %s" % (i, r.get("title", "")))
        print("   %s" % r.get("url", ""))
        body = (r.get("content") or "").strip().replace("\n", " ")
        if body:
            print("   %s" % body[:220])
        print()


if __name__ == "__main__":
    main()
